# ── NuGet local feed ──────────────────────────────────────────────────────────
nuget-packages/*
!nuget-packages/.gitkeep

# ── Per-developer local settings (not shared with the team) ───────────────────
build/build-private.config

# ── C# build artifacts ────────────────────────────────────────────────────────
src/obj/
src/bin/
src/publish_output/
build/obj/
build/bin/

# ── Compiled extension binaries (produced by just build) ─────────────────────
# Wildcards cover any team/project name set in build.config.
godot-project/addons/*/*/bin/windows/*.dll
godot-project/addons/*/*/bin/windows/*.pdb
godot-project/addons/*/*/bin/linux/*.so
godot-project/addons/*/*/bin/macos/*.dylib
godot-project/addons/*/*/bin/ios/*.dylib
godot-project/addons/*/*/bin/android/*.so

# ── Godot recommended ignores ─────────────────────────────────────────────────
# https://docs.godotengine.org/en/stable/tutorials/best_practices/version_control_systems.html

# Editor-generated cache and temporary files
godot-project/.godot/

# Export presets — can contain signing credentials and sensitive paths
godot-project/export_presets.cfg

# Compiled translation binaries (auto-generated from .csv source files)
godot-project/*.translation
